---
// src/components/Navigation.astro
const currentPath = Astro.url.pathname;
---

<header class="w-full border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    
    <!-- Logo / Projektname -->
    <a href="/" class="text-white font-bold tracking-wider hover:opacity-90 transition-opacity">
      ASTRO PROJECTS
    </a>
    
    <!-- Navigations-Links -->
    <nav class="flex gap-1 sm:gap-2">
      <a 
        href="/" 
        class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
          currentPath === "/" 
            ? "bg-slate-800 text-white" 
            : "text-slate-400 hover:text-white hover:bg-slate-900"
        }`}
      >
        Startseite
      </a>
      <a 
        href="/bilder" 
        class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
          currentPath === "/bilder" || currentPath === "/bilder/" 
            ? "bg-slate-800 text-white" 
            : "text-slate-400 hover:text-white hover:bg-slate-900"
        }`}
      >
        Bilder
      </a>
    </nav>
    
  </div>
</header>
