---
// 1. Astro-Bildkomponente importieren
import { Image } from 'astro:assets';

// 2. Dein Bild importieren
import husqRefsheet from '../assets/Refsheet - husq.png';
import pic1 from '../assets/pic1.jpg';
import pic2 from '../assets/pic2.png';
---

<div class="welcome-box">
  <h1>Hallo auf meiner Seite! 👋</h1>
  <p>Mein Name ist Husq und ich bin seit mittlerweile zwei Jahrzehnten Teil der Furry-Community in Deutschland.</p>
  
  <!-- 3. Das Bild wird hier direkt unter dem Text eingefügt -->
  <div class="image-wrapper">
    <Image 
      src={husqRefsheet} 
      alt="Husq Reference Sheet" 
    />
  </div>
</div>

<style>
  .welcome-box {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid #cba6f7;
    text-align: center;
    font-family: sans-serif;
    max-width: 500px;
    margin: 2rem auto;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  h1 {
    color: #cba6f7;
    margin-bottom: 0.5rem;
  }

  /* Neues CSS für das Bild, damit es perfekt in die Box passt */
  .image-wrapper {
    margin-top: 1.5rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #cba6f7;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
